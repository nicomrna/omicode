# ─── Formulario de contacto (https://resend.com) ───────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=tu-email-real@gmail.com
# Remitente de un dominio verificado en Resend (ej. contacto@omnicode.store)
CONTACT_FROM_EMAIL=omnicode <contacto@omnicode.store>

# ─── Panel de administración (/keystatic) ──────────────────────────────────
# Sin esta variable, el panel funciona SOLO en tu computadora (npm run dev) y
# guarda directo en los archivos. Con ella, guarda como commits en GitHub
# (necesario en producción). Ver README → "Panel de administración".
NEXT_PUBLIC_KEYSTATIC_REPO=
# Las siguientes 4 las genera el asistente del panel la primera vez que lo abrís
# con NEXT_PUBLIC_KEYSTATIC_REPO configurado. Copialas también a Vercel.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
